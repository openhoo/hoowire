# Development Compose configuration. Both secret values must be supplied.
# Choose a unique random password using only URL-safe characters (hex is suitable).
HOOWIRE_DB_PASSWORD=
# Base64 of exactly 32 random bytes, generated by: hoowire keygen
HOOWIRE_MASTER_KEY=
# Exposed only on host loopback by compose.yaml.
HOOWIRE_PORT=8080
# One connection is reserved for the process-wide event listener; minimum 2.
HOOWIRE_DB_MAX_CONNECTIONS=10
# Only migrate uses this per-statement limit; valid range 1..3600 seconds.
HOOWIRE_MIGRATION_STATEMENT_TIMEOUT_SECS=300
# Allow opaque browser Origin:null; disable for web-only deployments.
HOOWIRE_CORS_ALLOW_DESKTOP=true
# Exact allowed web UI origins, comma separated, without paths or trailing slashes.
# Example: https://chat.example.org,http://localhost:3000
HOOWIRE_CORS_WEB_ORIGINS=
RUST_LOG=hoowire=info
